# Postgres 연결 문자열. 비워두면 .data/pglite 에 로컬 내장 Postgres(PGlite)를 사용합니다.
# Supabase 프로젝트 itsmine (Transaction pooler). <비밀번호> 자리에 DB 비밀번호를 넣으세요.
# 비밀번호에 특수문자가 있으면 퍼센트 인코딩해야 합니다.
# DATABASE_URL=postgresql://postgres.oxeigksibzuuuiulnkaz:<비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 영수증 사진 인식(OCR)에 사용할 Anthropic API 키. 비워두면 사진 인식 기능이 비활성화됩니다.
ANTHROPIC_API_KEY=
